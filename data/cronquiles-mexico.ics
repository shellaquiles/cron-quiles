BEGIN:VEVENT
SUMMARY:Rust-AICollective|The Copilot Effect: Microsoft Fabric Copilot (w/
  The AI Collective)|Online
DTSTART:20260722T090000Z
CATEGORIES:ai
DESCRIPTION:Get up-to-date information at: https://luma.com/aic-du-7-22\n\
 nHosted by The AI Collective & Kaamil Motala
LOCATION:https://luma.com/event/evt-eRH6P56lxw25Lvw
X-CRONQUILES-ADDRESS:https://luma.com/event/evt-eRH6P56lxw25Lvw
